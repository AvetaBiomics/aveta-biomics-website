# Canonical site origin, used for canonical tags, Open Graph URLs and the
# sitemap. Defaults to https://www.avetabiomics.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.avetabiomics.com

# Optional review-site password.
# Leave unset for a public website. Set SITE_PASSWORD in Vercel to enable the review gate.
SITE_PASSWORD=replace-with-a-strong-password
