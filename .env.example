# Application form email delivery, via a Resend account. Without the key the
# form returns 503 and points applicants at the contact address, rather than
# silently dropping applications.
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend.
APPLICATIONS_FROM_EMAIL=Aveta Careers <careers@avetabiomics.com>

# Canonical site origin, used for canonical tags, Open Graph URLs and the
# sitemap. Defaults to https://avetabiomics.com when unset.
NEXT_PUBLIC_SITE_URL=https://avetabiomics.com

# Optional review-site password.
# Leave unset for a public website. Set SITE_PASSWORD in Vercel to enable the review gate.
SITE_PASSWORD=replace-with-a-strong-password
